# Required controller: decision_option_list_controller

vbox = {
	name = "decision_view_widget_ME_change_arabian_capital_decision"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = expanding
	ignoreinvisible = yes

	margin_top = 10
	spacing = 10

	text_label_center = {
		text = "ME_change_arabian_capital_pick_a_capital_gui"
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding		

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				vbox = {
					datamodel = "[DecisionViewWidgetOptionList.GetEntries]"
					spacing = 6

					item = {
						change_capital_arabian_empire = {}
					}
				}
			}

			blockoverride "scrollbox_background_fade" {}
		}
	}
}

types ME_change_arabian_capital_decisions
{
	type change_capital_arabian_empire = button_standard {
		size = { 450 70 }
		margin = { 10 10 }
		#tintcolor = { 0.91 0.78 0.60 0.4 }
		#tintcolor = "[TooltipInfo.GetTintColor]"

		onclick = "[DecisionViewWidgetOptionList.OnSelect(Entry.Self)]"
		enabled = "[Entry.IsEnabled]"
		tooltip = "[Entry.GetTooltip]"
		down = "[Entry.IsSelected]"

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 10
			margin_left = 10

			# icon = {
			# 	name = "RICE_granada_alhambra_decision_icon"
			# 	size = { 45 99 }
			# 	texture = "[Entry.GetIcon]"
			# }

			#icon = {
			#	name = "RICE_granada_alhambra_decision_icon"
			#	size = { 50 50 } # size = { 30 30 }
			#	texture = "[Entry.GetIcon]"
			#}

			vbox = {
				name = "ME_change_arabian_capital_decision_info"

				layoutpolicy_vertical = expanding
				margin_left = 15
				margin_bottom = 5

				text_single = {
					name = "ME_change_arabian_capital_decision_type"
					text = "[Entry.GetName]"
					max_width = 250
					align = left
				}
			}

			expand = {}
		}
	}
}

